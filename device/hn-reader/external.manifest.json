{
  "name": "HN Reader",
  "application": "/home/root/hn-reader/hn-reader",
  "workingDirectory": "/home/root/hn-reader",
  "environment": {
    "LD_PRELOAD": "/home/root/shims/qtfb-shim.so",
    "QTFB_SHIM_INPUT_MODE": "NATIVE",
    "QTFB_SHIM_MODE": "RM2FB",
    "QTFB_SHIM_RESPECT_FULL_REFRESH_REQUESTS": "1",
    "QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS": "rotate=180:invertx",
    "QT_QPA_PLATFORM_PLUGIN_PATH": "/home/root/hn-reader/plugins/platforms",
    "QT_QUICK_BACKEND": "software"
  },
  "args": ["-platform", "linuxfb:fb=/dev/fb0"],
  "qtfb": true,
  "aspectRatio": "original",
  "disablesWindowedMode": true
}
